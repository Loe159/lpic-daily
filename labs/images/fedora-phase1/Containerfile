# Development image recipe.
# Release automation must replace this tag with a verified digest before shipping.
FROM registry.fedoraproject.org/fedora:44

RUN dnf -y install \
        at \
        bash \
        bind-utils \
        btrfs-progs \
        bzip2 \
        chrony \
        coreutils \
        cpio \
        cronie \
        cups-client \
        diffutils \
        dnf \
        dosfstools \
        e2fsprogs \
        file \
        findutils \
        gawk \
        gnupg2 \
        grep \
        gzip \
        hostname \
        iproute \
        iputils \
        kitty-terminfo \
        less \
        logrotate \
        lsof \
        man-db \
        nano \
        net-tools \
        nmap-ncat \
        openssh-clients \
        parted \
        patchelf \
        plocate \
        procps-ng \
        rpm \
        rpm-build \
        createrepo_c \
        rsyslog \
        screen \
        sed \
        shadow-utils \
        s-nail \
        sudo \
        tar \
        tmux \
        util-linux \
        vim-enhanced \
        vim-minimal \
        which \
        xfsprogs \
        xz \
    && test -x /usr/bin/nano \
    && test -x /usr/bin/vi \
    && test -x /usr/bin/vim \
    && test -r /usr/share/terminfo/x/xterm-kitty \
    && groupadd --gid 2000 project \
    && useradd --create-home --uid 1101 --groups project alice \
    && useradd --create-home --uid 1102 --groups project bob \
    && install -d -m 0755 /opt/lpic/approved/bin /opt/lpic/shadow/bin /var/lib/lpic/reports /srv/shared \
    && dnf clean all

COPY --chmod=0755 report-status-approved /opt/lpic/approved/bin/report-status
COPY --chmod=0755 report-status-shadow /opt/lpic/shadow/bin/report-status

RUN install -d -m 0755 /opt/lpic/rpmbuild/{BUILD,BUILDROOT,RPMS,SOURCES,SPECS,SRPMS} /opt/lpic/rpmrepo \
    && cat > /opt/lpic/rpmbuild/SPECS/lpic-helper.spec <<'EOF'
Name: lpic-helper
Version: 1.0
Release: 1
Summary: LPIC Daily helper fixture
License: MIT
BuildArch: noarch
%description
Offline dependency fixture.
%install
mkdir -p %{buildroot}/usr/share/lpic-helper
printf 'helper-ok\n' > %{buildroot}/usr/share/lpic-helper/state.txt
%files
/usr/share/lpic-helper/state.txt
EOF
RUN cat > /opt/lpic/rpmbuild/SPECS/lpic-demo.spec <<'EOF'
Name: lpic-demo
Version: 1.0
Release: 1
Summary: LPIC Daily RPM fixture
License: MIT
BuildArch: noarch
Requires: lpic-helper >= 1.0
%description
Offline RPM practice fixture.
%install
mkdir -p %{buildroot}/usr/bin
cat > %{buildroot}/usr/bin/lpic-demo <<'SCRIPT'
#!/usr/bin/env bash
printf 'demo-ok\n'
SCRIPT
chmod 0755 %{buildroot}/usr/bin/lpic-demo
%files
/usr/bin/lpic-demo
EOF
RUN rpmbuild --define '_topdir /opt/lpic/rpmbuild' -bb /opt/lpic/rpmbuild/SPECS/lpic-helper.spec >/dev/null \
    && rpmbuild --define '_topdir /opt/lpic/rpmbuild' -bb /opt/lpic/rpmbuild/SPECS/lpic-demo.spec >/dev/null \
    && cp /opt/lpic/rpmbuild/RPMS/noarch/*.rpm /opt/lpic/rpmrepo/ \
    && createrepo_c /opt/lpic/rpmrepo >/dev/null \
    && rm -rf /opt/lpic/rpmbuild

CMD ["/usr/bin/sleep", "infinity"]
