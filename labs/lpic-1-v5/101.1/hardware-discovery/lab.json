{
  "schema_version": "1.0.0",
  "id": "lpic1.101.1.hardware-discovery",
  "title_fr": "Cartographier le matériel et ses couches Linux",
  "brief_fr": "Inspecte cette VM et enregistre sous /root/lpic-hardware : lspci -nn dans pci.txt, lsusb -t dans usb.txt, lsblk -dn -o NAME,TYPE dans storage.txt, readlink -f /sys/class/block/vda dans sys-vda.txt, udevadm info --query=property --name=/dev/vda dans udev-vda.txt et busctl --no-pager list dans dbus.txt. Charge ensuite le module dummy, capture lsmod dans modules-loaded.txt, puis retire dummy et capture modules-final.txt. Enfin écris dans proc-dev.txt les lignes Block/Character de /proc/devices.",
  "success_criteria_fr": [
    "Les snapshots PCI/USB et stockage correspondent à la VM.",
    "/sys, /dev, udev et D-Bus sont reliés à un device réel.",
    "Le module dummy est réellement chargé puis retiré.",
    "Les familles de devices caractère/bloc sont observées via /proc et /dev."
  ],
  "debrief_fr": "/proc expose l'état noyau, /sys représente les objets/devices, /dev fournit leurs nœuds et udev gère leur matérialisation. lspci/lsusb interrogent les bus, lsmod/modprobe les modules, D-Bus relie de nombreux services userland.",
  "objective_ids": [
    "101.1"
  ],
  "concept_ids": [
    "lpic1.101.1.role-de-proc-sys-et-dev",
    "lpic1.101.1.ressources-et-identification-du-materiel",
    "lpic1.101.1.modules-du-noyau-lies-au-materiel",
    "lpic1.101.1.bus-pci-et-usb",
    "lpic1.101.1.sysfs-udev-et-d-bus-comme-couches-de-decouverte-gestion",
    "lpic1.101.1.differences-entre-grandes-familles-de-stockage",
    "lpic1.101.1.activation-desactivation-peripheriques-integres",
    "lpic1.101.1.manipulation-des-peripheriques-usb"
  ],
  "labels": [
    "lpic-required",
    "modern-practice"
  ],
  "estimated_minutes": 22,
  "practice_context": "hardware-discovery-vm",
  "environment": {
    "backend": "libvirt",
    "image_ref": "fedora-44-x86_64-v2",
    "distribution": "fedora",
    "network": "none",
    "capability_profile": "full-machine",
    "writable_guest_paths": [],
    "machine": {
      "firmware": "uefi",
      "extra_disks": [
        {
          "id": "probe",
          "size_mb": 128
        }
      ]
    }
  },
  "resources": {
    "memory_mb": 1024,
    "pids": 192,
    "timeout_seconds": 2400,
    "cpu_percent": 100
  },
  "setup": {
    "execution_scope": "none"
  },
  "checks": [
    {
      "type": "command-exit",
      "argv": [
        "/usr/bin/bash",
        "-lc",
        "test -s /root/lpic-hardware/pci.txt && diff -q <(lspci -nn) /root/lpic-hardware/pci.txt >/dev/null"
      ],
      "expected_exit": 0,
      "concept_ids": [
        "lpic1.101.1.ressources-et-identification-du-materiel",
        "lpic1.101.1.bus-pci-et-usb"
      ]
    },
    {
      "type": "command-exit",
      "argv": [
        "/usr/bin/bash",
        "-lc",
        "test -f /root/lpic-hardware/usb.txt && diff -q <(lsusb -t) /root/lpic-hardware/usb.txt >/dev/null"
      ],
      "expected_exit": 0,
      "concept_ids": [
        "lpic1.101.1.bus-pci-et-usb",
        "lpic1.101.1.manipulation-des-peripheriques-usb"
      ]
    },
    {
      "type": "command-exit",
      "argv": [
        "/usr/bin/bash",
        "-lc",
        "grep -Eq '^vda[[:space:]]+disk$' /root/lpic-hardware/storage.txt && grep -Eq '^vdb[[:space:]]+disk$' /root/lpic-hardware/storage.txt"
      ],
      "expected_exit": 0,
      "concept_ids": [
        "lpic1.101.1.differences-entre-grandes-familles-de-stockage",
        "lpic1.101.1.ressources-et-identification-du-materiel"
      ]
    },
    {
      "type": "command-exit",
      "argv": [
        "/usr/bin/bash",
        "-lc",
        "test \"$(cat /root/lpic-hardware/sys-vda.txt)\" = \"$(readlink -f /sys/class/block/vda)\" && grep -q '^DEVNAME=/dev/vda$' /root/lpic-hardware/udev-vda.txt && grep -q 'org.freedesktop.systemd1' /root/lpic-hardware/dbus.txt"
      ],
      "expected_exit": 0,
      "concept_ids": [
        "lpic1.101.1.role-de-proc-sys-et-dev",
        "lpic1.101.1.sysfs-udev-et-d-bus-comme-couches-de-decouverte-gestion"
      ]
    },
    {
      "type": "command-exit",
      "argv": [
        "/usr/bin/bash",
        "-lc",
        "grep -Eq '^dummy[[:space:]]' /root/lpic-hardware/modules-loaded.txt && ! grep -Eq '^dummy[[:space:]]' /root/lpic-hardware/modules-final.txt && ! lsmod | grep -Eq '^dummy[[:space:]]'"
      ],
      "expected_exit": 0,
      "concept_ids": [
        "lpic1.101.1.modules-du-noyau-lies-au-materiel",
        "lpic1.101.1.activation-desactivation-peripheriques-integres"
      ]
    },
    {
      "type": "file-content-regex",
      "path": "/root/lpic-hardware/proc-dev.txt",
      "pattern": "^Character devices:\\nBlock devices:\\n?$",
      "concept_ids": [
        "lpic1.101.1.role-de-proc-sys-et-dev",
        "lpic1.101.1.differences-entre-grandes-familles-de-stockage"
      ]
    }
  ],
  "hint_ids": [
    "lpic1.101.1.hardware-discovery.hint-1",
    "lpic1.101.1.hardware-discovery.hint-2",
    "lpic1.101.1.hardware-discovery.hint-3",
    "lpic1.101.1.hardware-discovery.hint-4"
  ],
  "reference_solution_ref": "reference-solution.sh",
  "reset_policy": "disposable"
}
