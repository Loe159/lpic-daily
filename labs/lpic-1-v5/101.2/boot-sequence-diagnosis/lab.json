{
  "schema_version": "1.0.0",
  "id": "lpic1.101.2.boot-sequence-diagnosis",
  "title_fr": "Observer et modifier une séquence de boot",
  "brief_fr": "Ouvre d'abord :console au moins une fois pour observer le boot GRUB. Ajoute le paramètre noyau lpic_daily_stage=1012 dans la configuration persistante GRUB 2, régénère grub.cfg puis utilise :reboot. Après le redémarrage, crée /root/lpic-boot/ : cmdline.txt depuis /proc/cmdline, firmware.txt contenant UEFI ou BIOS selon /sys/firmware/efi, initramfs.txt depuis lsinitrd de l'initramfs courant, pid1.txt avec le nom de PID 1, init-link.txt avec la cible de /sbin/init et kernel-journal.txt avec journalctl -b -k.",
  "success_criteria_fr": [
    "La console série a réellement été ouverte.",
    "Le paramètre noyau persistant est chargé après reboot.",
    "La VM identifie correctement UEFI.",
    "L'initramfs courant est inspecté.",
    "PID 1/init montrent le système d'init actif et la compatibilité historique peut être située.",
    "Le journal noyau du boot courant est capturé."
  ],
  "debrief_fr": "Le firmware lance le bootloader, qui charge noyau et initramfs ; le noyau lance ensuite PID 1. UEFI se détecte via sysfs, /proc/cmdline expose les paramètres réellement chargés, lsinitrd inspecte l'initramfs et journalctl/dmesg servent au diagnostic après boot. Fedora utilise systemd tout en conservant certains points de compatibilité historiques.",
  "objective_ids": [
    "101.2"
  ],
  "concept_ids": [
    "lpic1.101.2.sequence-firmware-bootloader-kernel-initramfs-init-systemd",
    "lpic1.101.2.bios-versus-uefi",
    "lpic1.101.2.parametres-noyau-au-boot",
    "lpic1.101.2.role-de-initramfs",
    "lpic1.101.2.sysvinit-systemd-et-connaissance-historique-d-upstart",
    "lpic1.101.2.diagnostic-des-evenements-de-boot",
    "lpic1.101.2.commandes-du-chargeur-de-demarrage"
  ],
  "labels": [
    "lpic-required",
    "modern-practice"
  ],
  "estimated_minutes": 22,
  "practice_context": "boot-sequence-diagnosis",
  "environment": {
    "backend": "libvirt",
    "image_ref": "fedora-44-x86_64-v3",
    "distribution": "fedora",
    "network": "none",
    "capability_profile": "full-machine",
    "writable_guest_paths": [],
    "machine": {
      "firmware": "uefi"
    }
  },
  "resources": {
    "memory_mb": 1024,
    "pids": 192,
    "timeout_seconds": 2400,
    "cpu_percent": 100
  },
  "setup": {
    "execution_scope": "none"
  },
  "checks": [
    {
      "type": "command-exit",
      "argv": [
        "/usr/bin/grep",
        "-qw",
        "lpic_daily_stage=1012",
        "/proc/cmdline"
      ],
      "expected_exit": 0,
      "concept_ids": [
        "lpic1.101.2.sequence-firmware-bootloader-kernel-initramfs-init-systemd",
        "lpic1.101.2.parametres-noyau-au-boot"
      ]
    },
    {
      "type": "command-exit",
      "argv": [
        "/usr/bin/bash",
        "-lc",
        "grep -q 'lpic_daily_stage=1012' /etc/default/grub && grep -q 'lpic_daily_stage=1012' /boot/grub2/grub.cfg"
      ],
      "expected_exit": 0,
      "concept_ids": [
        "lpic1.101.2.sequence-firmware-bootloader-kernel-initramfs-init-systemd",
        "lpic1.101.2.parametres-noyau-au-boot",
        "lpic1.101.2.commandes-du-chargeur-de-demarrage"
      ]
    },
    {
      "type": "file-content-regex",
      "path": "/root/lpic-boot/firmware.txt",
      "pattern": "^UEFI\\n?$",
      "concept_ids": [
        "lpic1.101.2.bios-versus-uefi",
        "lpic1.101.2.sequence-firmware-bootloader-kernel-initramfs-init-systemd"
      ]
    },
    {
      "type": "command-exit",
      "argv": [
        "/usr/bin/bash",
        "-lc",
        "test -d /sys/firmware/efi && test -s /root/lpic-boot/initramfs.txt && grep -Eq 'usr/lib|etc|kernel' /root/lpic-boot/initramfs.txt"
      ],
      "expected_exit": 0,
      "concept_ids": [
        "lpic1.101.2.bios-versus-uefi",
        "lpic1.101.2.role-de-initramfs",
        "lpic1.101.2.sequence-firmware-bootloader-kernel-initramfs-init-systemd"
      ]
    },
    {
      "type": "file-content-regex",
      "path": "/root/lpic-boot/pid1.txt",
      "pattern": "^systemd\\n?$",
      "concept_ids": [
        "lpic1.101.2.sysvinit-systemd-et-connaissance-historique-d-upstart",
        "lpic1.101.2.sequence-firmware-bootloader-kernel-initramfs-init-systemd"
      ]
    },
    {
      "type": "command-exit",
      "argv": [
        "/usr/bin/bash",
        "-lc",
        "grep -q 'systemd' /root/lpic-boot/init-link.txt && test -d /etc/init.d && test ! -e /sbin/upstart"
      ],
      "expected_exit": 0,
      "concept_ids": [
        "lpic1.101.2.sysvinit-systemd-et-connaissance-historique-d-upstart"
      ]
    },
    {
      "type": "command-exit",
      "argv": [
        "/usr/bin/bash",
        "-lc",
        "test -s /root/lpic-boot/kernel-journal.txt && grep -Eqi 'Linux version|kernel command line|Command line' /root/lpic-boot/kernel-journal.txt"
      ],
      "expected_exit": 0,
      "concept_ids": [
        "lpic1.101.2.diagnostic-des-evenements-de-boot",
        "lpic1.101.2.sequence-firmware-bootloader-kernel-initramfs-init-systemd"
      ]
    },
    {
      "type": "command-exit",
      "argv": [
        "/usr/bin/bash",
        "-lc",
        "grub2-install --version | grep -qi grub"
      ],
      "expected_exit": 0,
      "concept_ids": [
        "lpic1.101.2.commandes-du-chargeur-de-demarrage"
      ]
    }
  ],
  "hint_ids": [
    "lpic1.101.2.boot-sequence-diagnosis.hint-1",
    "lpic1.101.2.boot-sequence-diagnosis.hint-2",
    "lpic1.101.2.boot-sequence-diagnosis.hint-3",
    "lpic1.101.2.boot-sequence-diagnosis.hint-4"
  ],
  "reference_solution_ref": "reference-solution.sh",
  "reset_policy": "disposable",
  "requires_vm_console": true
}
