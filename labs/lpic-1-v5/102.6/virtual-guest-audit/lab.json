{
  "schema_version": "1.0.0",
  "id": "lpic1.102.6.virtual-guest-audit",
  "title_fr": "Auditer une VM comme instance clonée",
  "brief_fr": "Produis /root/lpic-virt : virt-type.txt depuis systemd-detect-virt, block.txt depuis lsblk, network.txt depuis ip -o link, machine-id.txt depuis /etc/machine-id, ssh-hostkeys.txt avec les empreintes SHA256 des clés hôte SSH, guest-agent.txt avec l'état de qemu-guest-agent, et cloud.txt avec l'état de cloud-init ainsi que la présence de /etc/cloud/cloud.cfg. Le but est de distinguer une VM d'un conteneur et de vérifier les identités/guest drivers d'une image clonable.",
  "success_criteria_fr": [
    "La machine est détectée comme environnement virtualisé et possède des ressources block/network virtuelles.",
    "machine-id et clés hôte SSH sont présentes et régénérées dans l'instance.",
    "qemu-guest-agent est actif.",
    "cloud-init/configuration cloud est inspectée comme mécanisme de personnalisation d'image."
  ],
  "debrief_fr": "Une VM possède son propre noyau invité et des devices virtuels, contrairement à un conteneur qui partage le noyau hôte. Les images/templates doivent régénérer machine-id et clés SSH. Les guest agents/drivers améliorent l'intégration et cloud-init applique la personnalisation au premier boot.",
  "objective_ids": [
    "102.6"
  ],
  "concept_ids": [
    "lpic1.102.6.vm-versus-conteneur-applicatif-systeme",
    "lpic1.102.6.ressources-virtuelles-block-network",
    "lpic1.102.6.images-clones-et-templates",
    "lpic1.102.6.identites-devant-etre-regenerees-lors-d-un-clonage",
    "lpic1.102.6.guest-drivers",
    "lpic1.102.6.principes-cloud-init-iaas"
  ],
  "labels": [
    "lpic-required",
    "modern-practice"
  ],
  "estimated_minutes": 22,
  "practice_context": "virtual-guest-audit",
  "environment": {
    "backend": "libvirt",
    "image_ref": "fedora-44-x86_64-v2",
    "distribution": "fedora",
    "network": "none",
    "capability_profile": "full-machine",
    "writable_guest_paths": [],
    "machine": {
      "firmware": "uefi"
    }
  },
  "resources": {
    "memory_mb": 1024,
    "pids": 192,
    "timeout_seconds": 2400,
    "cpu_percent": 100
  },
  "setup": {
    "execution_scope": "none"
  },
  "checks": [
    {
      "type": "command-exit",
      "argv": [
        "/usr/bin/bash",
        "-lc",
        "grep -Eq '^(kvm|qemu)$' /root/lpic-virt/virt-type.txt && ! grep -Eq '^(docker|podman|lxc)$' /root/lpic-virt/virt-type.txt"
      ],
      "expected_exit": 0,
      "concept_ids": [
        "lpic1.102.6.vm-versus-conteneur-applicatif-systeme"
      ]
    },
    {
      "type": "command-exit",
      "argv": [
        "/usr/bin/bash",
        "-lc",
        "grep -Eq '^vda[[:space:]]+disk$' /root/lpic-virt/block.txt && grep -q ': lo:' /root/lpic-virt/network.txt && grep -Eq ': (en|eth)' /root/lpic-virt/network.txt"
      ],
      "expected_exit": 0,
      "concept_ids": [
        "lpic1.102.6.ressources-virtuelles-block-network"
      ]
    },
    {
      "type": "command-exit",
      "argv": [
        "/usr/bin/bash",
        "-lc",
        "id=$(cat /root/lpic-virt/machine-id.txt); test -n \"$id\" && test \"$id\" = \"$(cat /etc/machine-id)\" && test -s /root/lpic-virt/ssh-hostkeys.txt && grep -q 'SHA256:' /root/lpic-virt/ssh-hostkeys.txt"
      ],
      "expected_exit": 0,
      "concept_ids": [
        "lpic1.102.6.images-clones-et-templates",
        "lpic1.102.6.identites-devant-etre-regenerees-lors-d-un-clonage"
      ]
    },
    {
      "type": "file-content-regex",
      "path": "/root/lpic-virt/guest-agent.txt",
      "pattern": "^active\\n?$",
      "concept_ids": [
        "lpic1.102.6.guest-drivers"
      ]
    },
    {
      "type": "command-exit",
      "argv": [
        "/usr/bin/bash",
        "-lc",
        "grep -q '^cloud-config:present$' /root/lpic-virt/cloud.txt && command -v cloud-init >/dev/null"
      ],
      "expected_exit": 0,
      "concept_ids": [
        "lpic1.102.6.images-clones-et-templates",
        "lpic1.102.6.principes-cloud-init-iaas"
      ]
    }
  ],
  "hint_ids": [
    "lpic1.102.6.virtual-guest-audit.hint-1",
    "lpic1.102.6.virtual-guest-audit.hint-2",
    "lpic1.102.6.virtual-guest-audit.hint-3",
    "lpic1.102.6.virtual-guest-audit.hint-4"
  ],
  "reference_solution_ref": "reference-solution.sh",
  "reset_policy": "disposable"
}
