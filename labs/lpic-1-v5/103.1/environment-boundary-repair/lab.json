  "checks": [
    {
      "type": "command-exit",
      "argv": [
        "/usr/bin/timeout",
        "-k",
        "1s",
        "3s",
        "/usr/bin/bash",
        "--noprofile",
        "--norc",
        "-c",
        "mask=$(/usr/bin/cat /run/lpic/.environment-check-state 2>/dev/null) || exit 125\n[[ \"$mask\" =~ ^([0-9]|[12][0-9]|3[01])$ ]] || exit 125\nexit \"$((160+mask))\""
      ],
      "expected_exit": 0,
      "concept_ids": [
