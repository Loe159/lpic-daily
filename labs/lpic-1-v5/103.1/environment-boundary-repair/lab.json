{
  "schema_version": "1.0.0",
  "id": "lpic1.103.1.environment-boundary-repair",
  "title_fr": "Réparer la frontière entre shell et environnement",
  "brief_fr": "Lors d’une relève, les programmes lancés depuis le terminal reçoivent des informations incorrectes. Le service doit fonctionner en mode production, une note réservée à l’opérateur doit rester invisible aux processus enfants et un ancien secret ne doit plus exister. Corrige la session en cours, sans rendre ces changements permanents. Transmets au prochain opérateur un résumé /run/lpic/env-summary indiquant le mode de service et la note locale, séparés par un caractère |.",
  "success_criteria_fr": [
    "SERVICE_MODE vaut production et est visible dans l’environnement d’un processus enfant.",
    "LOCAL_NOTE vaut operator-note dans le shell mais n’apparaît pas dans env.",
    "LEGACY_TOKEN est absente du shell et de l’environnement transmis.",
    "env-summary contient production|operator-note à partir des valeurs réellement chargées."
  ],
  "debrief_fr": "set expose les variables du shell tandis que env montre l’environnement transmis à un processus. export ajoute une variable à cet environnement et unset la retire du shell. L’expansion de variables produit ensuite le résumé attendu sans confondre valeur locale et valeur exportée.",
  "objective_ids": [
    "103.1"
  ],
  "concept_ids": [
    "lpic1.103.1.set-env-et-portee-des-variables",
    "lpic1.103.1.export-unset-et-processus-enfants",
    "lpic1.103.1.echo-et-expansion-shell",
    "lpic1.103.1.variables-shell-environnement"
  ],
  "labels": [
    "lpic-required",
    "modern-practice",
    "scenario-accepted"
  ],
  "estimated_minutes": 10,
  "practice_context": "environment-boundary-repair",
  "environment": {
    "backend": "podman",
    "image_ref": "localhost/lpic-daily/fedora-phase1:1",
    "distribution": "fedora",
    "network": "none",
    "capability_profile": "baseline",
    "writable_guest_paths": [
      "/root",
      "/run/lpic"
    ]
  },
  "resources": {
    "memory_mb": 256,
    "pids": 96,
    "timeout_seconds": 1200,
    "cpu_percent": 100
  },
  "setup": {
    "execution_scope": "sandbox",
    "script_ref": "setup.sh"
