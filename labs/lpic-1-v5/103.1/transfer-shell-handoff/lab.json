{
  "schema_version": "1.0.0",
  "id": "lpic1.103.1.transfer-shell-handoff",
  "title_fr": "Préparer un shell de relève interactif",
  "brief_fr": "Tu prépares un shell interactif pour une relève d’astreinte, sans modifier le profil de login. Corrige /root/.bashrc afin qu’un bash interactif résolve report-status vers le binaire approuvé, exporte HANDOFF_ROLE=primary et HANDOFF_FILE=/var/lib/lpic/reports/handoff notes.txt, et conserve un historique exploitable avec HISTSIZE=1500, HISTFILESIZE=3000 et HISTCONTROL=ignoredups. Depuis ce shell, produis /run/lpic/handoff-summary avec l’architecture uname -m sur la première ligne et le type Bash de report-status sur la seconde, puis /run/lpic/handoff-ready contenant ready.",
  "success_criteria_fr": [
    "Un shell interactif charge /root/.bashrc et résout report-status vers le binaire approuvé.",
    "HANDOFF_ROLE et HANDOFF_FILE sont exportées avec la valeur et le quoting attendus.",
    "HISTSIZE=1500, HISTFILESIZE=3000 et HISTCONTROL=ignoredups sont actifs dans ce shell interactif.",
    "handoff-summary contient l’architecture courante puis le type Bash réel de report-status.",
    "handoff-ready est créé dans la même séquence de préparation et contient ready."
  ],
  "debrief_fr": "Ce deuxième contexte transfère les sept concepts 103.1 sans réutiliser le même état initial : séquences de shell, variables, PATH, quoting, historique, identification des commandes et informations système.",
  "objective_ids": [
    "103.1"
  ],
  "concept_ids": [
    "lpic1.103.1.syntaxe-shell-et-sequences-de-commandes",
    "lpic1.103.1.variables-shell-environnement",
    "lpic1.103.1.path-et-resolution-de-commande",
    "lpic1.103.1.quoting-escaping",
    "lpic1.103.1.historique",
    "lpic1.103.1.documentation-et-identification-d-une-commande",
    "lpic1.103.1.informations-systeme-de-base"
  ],
  "labels": [
    "lpic-required",
    "modern-practice"
  ],
  "estimated_minutes": 12,
  "practice_context": "shell-handoff",
  "environment": {
    "backend": "podman",
    "image_ref": "localhost/lpic-daily/fedora-phase1:1",
    "distribution": "fedora",
    "network": "none",
    "capability_profile": "baseline",
    "writable_guest_paths": [
      "/root",
      "/run/lpic",
      "/var/lib/lpic/reports"
    ]
  },
  "resources": {
    "memory_mb": 256,
    "pids": 96,
    "timeout_seconds": 1200,
    "cpu_percent": 100
  },
  "setup": {
    "execution_scope": "sandbox",
    "script_ref": "setup.sh"
  },
  "checks": [
    {
      "type": "command-exit",
      "argv": [
        "/usr/bin/bash",
        "--noprofile",
        "--rcfile",
        "/root/.bashrc",
        "-ic",
        "test \"$(command -v report-status)\" = /opt/lpic/approved/bin/report-status"
      ],
      "expected_exit": 0,
      "concept_ids": [
        "lpic1.103.1.path-et-resolution-de-commande",
        "lpic1.103.1.documentation-et-identification-d-une-commande"
      ]
    },
    {
      "type": "command-exit",
      "argv": [
        "/usr/bin/bash",
        "--noprofile",
        "--rcfile",
        "/root/.bashrc",
        "-ic",
        "test \"${HANDOFF_ROLE:-}\" = primary"
      ],
      "expected_exit": 0,
      "concept_ids": [
        "lpic1.103.1.variables-shell-environnement"
      ]
    },
    {
      "type": "command-exit",
      "argv": [
        "/usr/bin/bash",
        "--noprofile",
        "--rcfile",
        "/root/.bashrc",
        "-ic",
        "test \"${HANDOFF_FILE:-}\" = \"/var/lib/lpic/reports/handoff notes.txt\""
      ],
      "expected_exit": 0,
      "concept_ids": [
        "lpic1.103.1.variables-shell-environnement",
        "lpic1.103.1.quoting-escaping"
      ]
    },
    {
      "type": "command-exit",
      "argv": [
        "/usr/bin/bash",
        "--noprofile",
        "--rcfile",
        "/root/.bashrc",
        "-ic",
        "test \"${HISTSIZE:-}\" = 1500 && test \"${HISTFILESIZE:-}\" = 3000 && test \"${HISTCONTROL:-}\" = ignoredups"
      ],
      "expected_exit": 0,
      "concept_ids": [
        "lpic1.103.1.historique",
        "lpic1.103.1.syntaxe-shell-et-sequences-de-commandes"
      ]
    },
    {
      "type": "command-exit",
      "argv": [
        "/usr/bin/bash",
        "-lc",
        "test -f /run/lpic/handoff-summary && test \"$(sed -n '1p' /run/lpic/handoff-summary)\" = \"$(uname -m)\" && test \"$(sed -n '2p' /run/lpic/handoff-summary)\" = file"
      ],
      "expected_exit": 0,
      "concept_ids": [
        "lpic1.103.1.informations-systeme-de-base",
        "lpic1.103.1.documentation-et-identification-d-une-commande"
      ]
    },
    {
      "type": "file-content-regex",
      "path": "/run/lpic/handoff-ready",
      "pattern": "^ready\\n?$",
      "concept_ids": [
        "lpic1.103.1.syntaxe-shell-et-sequences-de-commandes",
        "lpic1.103.1.quoting-escaping"
      ]
    }
  ],
  "hint_ids": [
    "lpic1.103.1.transfer-shell-handoff.hint-1",
    "lpic1.103.1.transfer-shell-handoff.hint-2",
    "lpic1.103.1.transfer-shell-handoff.hint-3",
    "lpic1.103.1.transfer-shell-handoff.hint-4"
  ],
  "reference_solution_ref": "reference-solution.sh",
  "reset_policy": "disposable"
}
