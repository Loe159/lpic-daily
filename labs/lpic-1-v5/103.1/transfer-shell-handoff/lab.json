{
  "schema_version": "1.0.0",
  "id": "lpic1.103.1.transfer-shell-handoff",
  "title_fr": "Préparer un shell de relève interactif",
  "brief_fr": "Le shell interactif d'une relève d'astreinte utilise un mauvais outil et de mauvaises variables. Répare /root/.bashrc, sans toucher au profil de login : privilégie report-status approuvé dans PATH, règle HANDOFF_ROLE=primary, HANDOFF_FILE vers le rapport contenant un espace et HISTSIZE=1500, HISTFILESIZE=3000, HISTCONTROL=ignoredups. Fournis /run/lpic/handoff-summary à ton collègue avec l'architecture (uname -m), puis le type Bash de report-status.",
  "success_criteria_fr": [
    "Un nouveau shell interactif résout report-status vers le binaire approuvé.",
    "Les deux variables de relève sont exportées et le chemin contenant un espace est conservé intégralement.",
    "HISTSIZE=1500, HISTFILESIZE=3000 et HISTCONTROL=ignoredups sont actifs dans ce shell.",
    "Le rapport /run/lpic/handoff-summary contient l’architecture puis le type Bash réellement identifié pour report-status."
  ],
  "debrief_fr": "Ce deuxième contexte transfère les sept concepts 103.1 sans réutiliser le même état initial : séquences de shell, variables, PATH, quoting, historique, identification des commandes et informations système.",
  "objective_ids": [
    "103.1"
  ],
  "concept_ids": [
    "lpic1.103.1.syntaxe-shell-et-sequences-de-commandes",
    "lpic1.103.1.variables-shell-environnement",
    "lpic1.103.1.path-et-resolution-de-commande",
    "lpic1.103.1.quoting-escaping",
    "lpic1.103.1.historique",
    "lpic1.103.1.documentation-et-identification-d-une-commande",
    "lpic1.103.1.informations-systeme-de-base"
  ],
  "labels": [
    "lpic-required",
    "modern-practice",
    "scenario-accepted"
  ],
  "estimated_minutes": 12,
  "practice_context": "shell-handoff",
  "environment": {
    "backend": "podman",
    "image_ref": "localhost/lpic-daily/fedora-phase1:1",
    "distribution": "fedora",
    "network": "none",
    "capability_profile": "baseline",
    "writable_guest_paths": [
      "/root",
      "/run/lpic",
      "/var/lib/lpic/reports"
    ]
  },
  "resources": {
    "memory_mb": 256,
    "pids": 96,
    "timeout_seconds": 1200,
    "cpu_percent": 100
  },
  "setup": {
    "execution_scope": "sandbox",
    "script_ref": "setup.sh"
  },
  "checks": [
    {
      "type": "command-exit",
      "argv": [
        "/usr/bin/bash",
        "--noprofile",
        "--norc",
        "-c",
        ". \"/root/.bashrc\" || exit 1; test \"$(command -v report-status)\" = /opt/lpic/approved/bin/report-status"
      ],
      "expected_exit": 0,
      "concept_ids": [
        "lpic1.103.1.path-et-resolution-de-commande",
        "lpic1.103.1.documentation-et-identification-d-une-commande"
      ],
      "timeout_seconds": 10,
      "description_fr": "report-status se résout vers le binaire approuvé via PATH."
    },
    {
      "type": "command-exit",
      "argv": [
        "/usr/bin/bash",
        "--noprofile",
        "--norc",
        "-c",
        ". \"/root/.bashrc\" || exit 1; test \"${HANDOFF_ROLE:-}\" = primary"
      ],
      "expected_exit": 0,
      "concept_ids": [
        "lpic1.103.1.variables-shell-environnement"
      ],
      "timeout_seconds": 10,
      "description_fr": "HANDOFF_ROLE vaut primary dans le shell configuré."
    },
    {
      "type": "command-exit",
      "argv": [
        "/usr/bin/bash",
        "--noprofile",
        "--norc",
        "-c",
        ". \"/root/.bashrc\" || exit 1; test \"${HANDOFF_FILE:-}\" = \"/var/lib/lpic/reports/handoff notes.txt\""
      ],
      "expected_exit": 0,
      "concept_ids": [
        "lpic1.103.1.variables-shell-environnement",
        "lpic1.103.1.quoting-escaping"
      ],
      "timeout_seconds": 10,
      "description_fr": "HANDOFF_FILE pointe vers le rapport avec son espace dans le nom."
    },
    {
      "type": "command-exit",
      "argv": [
        "/usr/bin/bash",
        "--noprofile",
        "--norc",
        "-c",
        ". \"/root/.bashrc\" || exit 1; test \"${HISTSIZE:-}\" = 1500 && test \"${HISTFILESIZE:-}\" = 3000 && test \"${HISTCONTROL:-}\" = ignoredups"
      ],
      "expected_exit": 0,
      "concept_ids": [
        "lpic1.103.1.historique",
        "lpic1.103.1.syntaxe-shell-et-sequences-de-commandes"
      ],
      "timeout_seconds": 10,
      "description_fr": "L'historique utilise les tailles et la politique de doublons attendues."
    },
    {
      "type": "command-exit",
      "argv": [
        "/usr/bin/bash",
        "-lc",
        "test -f /run/lpic/handoff-summary && test \"$(sed -n '1p' /run/lpic/handoff-summary)\" = \"$(uname -m)\" && test \"$(sed -n '2p' /run/lpic/handoff-summary)\" = file"
      ],
      "expected_exit": 0,
      "concept_ids": [
        "lpic1.103.1.informations-systeme-de-base",
        "lpic1.103.1.documentation-et-identification-d-une-commande"
      ]
    }
  ],
  "hint_ids": [
    "lpic1.103.1.transfer-shell-handoff.hint-1",
    "lpic1.103.1.transfer-shell-handoff.hint-2",
    "lpic1.103.1.transfer-shell-handoff.hint-3",
    "lpic1.103.1.transfer-shell-handoff.hint-4"
  ],
  "reference_solution_ref": "reference-solution.sh",
  "reset_policy": "disposable"
}
