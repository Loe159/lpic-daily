{
  "schema_version": "1.0.0",
  "id": "lpic1.103.5.transfer-operator-session",
  "title_fr": "Conduire une relève de maintenance",
  "brief_fr": "Pendant une maintenance, reload-worker doit rester actif mais recevoir un rechargement sans interruption. Dans :shell, localise-le par nom, enregistre un snapshot PID/PPID/état/commande dans /run/lpic/maintenance-inspection puis envoie-lui SIGUSR1 et vérifie qu’il reste actif. Lance ensuite lpic-maintenance-job-probe au premier plan, suspends-le avec Ctrl-Z, observe-le avec jobs, reprends-le avec bg puis termine-le avec SIGTERM. Enfin démarre batch-worker en arrière-plan, handoff-daemon avec nohup et une session tmux détachée nommée maintenance-ops.",
  "success_criteria_fr": [
    "reload-worker reste actif après réception de SIGUSR1 et /run/lpic/reload-requested confirme le rechargement.",
    "/run/lpic/maintenance-inspection contient un snapshot exploitable du reload-worker avec PID, PPID, état et commande.",
    "Le maintenance-job-probe a réellement été suspendu, observé via jobs, repris en arrière-plan puis terminé.",
    "batch-worker et handoff-daemon restent actifs, le second ayant été lancé avec nohup.",
    "Une session tmux détachée maintenance-ops existe."
  ],
  "debrief_fr": "Ce contexte exige à nouveau inspection et sélection précises des processus, puis un vrai cycle de job control dans un PTY : foreground, Ctrl-Z, jobs, bg et SIGTERM. Il ajoute un processus lancé avec &, un survivant nohup et une session tmux détachée. Le transfert n'est donc crédité que lorsque les sept concepts 103.5 ont une preuve observable dans ce second contexte.",
  "objective_ids": [
    "103.5"
  ],
  "concept_ids": [
    "lpic1.103.5.processus-avant-arriere-plan",
    "lpic1.103.5.jobs-du-shell",
    "lpic1.103.5.signaux",
    "lpic1.103.5.inspection-arbres-ressources",
    "lpic1.103.5.processus-survivant-a-la-session",
    "lpic1.103.5.selection-par-nom-pid",
    "lpic1.103.5.multiplexeurs-de-terminal"
  ],
  "labels": [
    "lpic-required",
    "modern-practice"
  ],
  "estimated_minutes": 12,
  "practice_context": "operator-session",
  "environment": {
    "backend": "podman",
    "image_ref": "localhost/lpic-daily/fedora-phase1:1",
    "distribution": "fedora",
    "network": "none",
    "capability_profile": "process-lab",
    "writable_guest_paths": [
      "/run/lpic",
      "/usr/local/bin"
    ]
  },
  "resources": {
    "memory_mb": 256,
    "pids": 128,
    "timeout_seconds": 1200,
    "cpu_percent": 100
  },
  "setup": {
    "execution_scope": "sandbox",
    "script_ref": "setup.sh"
  },
  "checks": [
    {
      "type": "process-running",
      "match": "reload-worker",
      "concept_ids": [
        "lpic1.103.5.selection-par-nom-pid"
      ]
    },
    {
      "type": "file-content-regex",
      "path": "/run/lpic/reload-requested",
      "pattern": "^reload\\n?$",
      "concept_ids": [
        "lpic1.103.5.signaux",
        "lpic1.103.5.selection-par-nom-pid"
      ]
    },
    {
      "type": "command-exit",
      "argv": [
        "/usr/bin/bash",
        "-lc",
        "test -s /run/lpic/maintenance-inspection && grep -Eq \"^[[:space:]]*$(cat /run/lpic/reload-worker.pid)[[:space:]]+[0-9]+[[:space:]]+[A-Z]\" /run/lpic/maintenance-inspection && grep -q reload-worker /run/lpic/maintenance-inspection"
      ],
      "expected_exit": 0,
      "concept_ids": [
        "lpic1.103.5.inspection-arbres-ressources"
      ]
    },
    {
      "type": "file-content-regex",
      "path": "/run/lpic/maintenance-probe-background",
      "pattern": "^background\\n?$",
      "concept_ids": [
        "lpic1.103.5.processus-avant-arriere-plan",
        "lpic1.103.5.jobs-du-shell"
      ]
    },
    {
      "type": "file-content-regex",
      "path": "/run/lpic/maintenance-probe-stopped",
      "pattern": "^stopped\\n?$",
      "concept_ids": [
        "lpic1.103.5.jobs-du-shell",
        "lpic1.103.5.signaux"
      ]
    },
    {
      "type": "file-content-regex",
      "path": "/run/lpic/maintenance-probe-continued",
      "pattern": "^continued\\n?$",
      "concept_ids": [
        "lpic1.103.5.processus-avant-arriere-plan",
        "lpic1.103.5.signaux"
      ]
    },
    {
      "type": "file-content-regex",
      "path": "/run/lpic/maintenance-probe-terminated",
      "pattern": "^terminated\\n?$",
      "concept_ids": [
        "lpic1.103.5.signaux"
      ]
    },
    {
      "type": "process-absent",
      "match": "/usr/local/bin/lpic-maintenance-job-probe",
      "concept_ids": [
        "lpic1.103.5.signaux"
      ]
    },
    {
      "type": "process-running",
      "match": "batch-worker",
      "concept_ids": [
        "lpic1.103.5.processus-avant-arriere-plan"
      ]
    },
    {
      "type": "process-running",
      "match": "handoff-daemon",
      "concept_ids": [
        "lpic1.103.5.processus-survivant-a-la-session"
      ]
    },
    {
      "type": "command-exit",
      "argv": [
        "/usr/bin/tmux",
        "has-session",
        "-t",
        "maintenance-ops"
      ],
      "expected_exit": 0,
      "concept_ids": [
        "lpic1.103.5.multiplexeurs-de-terminal"
      ]
    }
  ],
  "hint_ids": [
    "lpic1.103.5.transfer-operator-session.hint-1",
    "lpic1.103.5.transfer-operator-session.hint-2",
    "lpic1.103.5.transfer-operator-session.hint-3",
    "lpic1.103.5.transfer-operator-session.hint-4"
  ],
  "reference_solution_ref": "reference-solution.sh",
  "reset_policy": "disposable",
  "requires_persistent_shell": true
}
