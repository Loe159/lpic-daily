{
  "schema_version": "1.0.0",
  "id": "lpic1.104.1.filesystem-families",
  "title_fr": "Créer plusieurs familles de filesystems",
  "brief_fr": "Quatre disques jetables sont attachés : /dev/vdb doit devenir XFS label LPICXFS. Sur /dev/vdc, crée une table GPT avec deux partitions puis formate /dev/vdc1 en VFAT label LPICVFAT et /dev/vdc2 en exFAT label LPICEXFAT. Crée ensuite un filesystem Btrfs multi-device sur /dev/vdd et /dev/vde, label LPICBTRFS, monte-le sur /mnt/btrfs avec compression zstd et crée le subvolume /mnt/btrfs/data. Ne touche jamais /dev/vda.",
  "success_criteria_fr": [
    "vdb est XFS.",
    "vdc1 est VFAT et vdc2 exFAT.",
    "vdd+vde forment un Btrfs multi-device.",
    "Le Btrfs est monté avec compression zstd et possède le subvolume data."
  ],
  "debrief_fr": "mkfs choisit le format adapté au besoin. XFS, VFAT/exFAT et Btrfs ont des propriétés différentes ; Btrfs peut agréger plusieurs devices, appliquer une compression au montage et gérer des subvolumes.",
  "objective_ids": [
    "104.1"
  ],
  "concept_ids": [
    "lpic1.104.1.xfs",
    "lpic1.104.1.vfat-exfat",
    "lpic1.104.1.principes-btrfs-multi-device-compression-subvolumes",
    "lpic1.104.1.creation-de-filesystem"
  ],
  "labels": [
    "lpic-required",
    "modern-practice"
  ],
  "estimated_minutes": 22,
  "practice_context": "filesystem-family-comparison",
  "environment": {
    "backend": "libvirt",
    "image_ref": "fedora-44-x86_64-v2",
    "distribution": "fedora",
    "network": "none",
    "capability_profile": "full-machine",
    "writable_guest_paths": [],
    "machine": {
      "firmware": "uefi",
      "extra_disks": [
        {
          "id": "xfs",
          "size_mb": 512
        },
        {
          "id": "fat-family",
          "size_mb": 768
        },
        {
          "id": "btrfs-a",
          "size_mb": 512
        },
        {
          "id": "btrfs-b",
          "size_mb": 512
        }
      ]
    }
  },
  "resources": {
    "memory_mb": 1024,
    "pids": 192,
    "timeout_seconds": 2400,
    "cpu_percent": 100
  },
  "setup": {
    "execution_scope": "none"
  },
  "checks": [
    {
      "type": "block-device-state",
      "path": "/dev/vdb",
      "device_type": "disk",
      "filesystem": "xfs",
      "concept_ids": [
        "lpic1.104.1.xfs",
        "lpic1.104.1.creation-de-filesystem"
      ]
    },
    {
      "type": "block-device-state",
      "path": "/dev/vdc1",
      "device_type": "part",
      "filesystem": "vfat",
      "concept_ids": [
        "lpic1.104.1.vfat-exfat",
        "lpic1.104.1.creation-de-filesystem"
      ]
    },
    {
      "type": "block-device-state",
      "path": "/dev/vdc2",
      "device_type": "part",
      "filesystem": "exfat",
      "concept_ids": [
        "lpic1.104.1.vfat-exfat",
        "lpic1.104.1.creation-de-filesystem"
      ]
    },
    {
      "type": "block-device-state",
      "path": "/dev/vdd",
      "device_type": "disk",
      "filesystem": "btrfs",
      "mountpoint": "/mnt/btrfs",
      "concept_ids": [
        "lpic1.104.1.principes-btrfs-multi-device-compression-subvolumes",
        "lpic1.104.1.creation-de-filesystem"
      ]
    },
    {
      "type": "block-device-state",
      "path": "/dev/vde",
      "device_type": "disk",
      "filesystem": "btrfs",
      "concept_ids": [
        "lpic1.104.1.principes-btrfs-multi-device-compression-subvolumes"
      ]
    },
    {
      "type": "command-exit",
      "argv": [
        "/usr/bin/bash",
        "-lc",
        "btrfs filesystem show /mnt/btrfs | grep -q '/dev/vdd' && btrfs filesystem show /mnt/btrfs | grep -q '/dev/vde' && btrfs subvolume show /mnt/btrfs/data >/dev/null && findmnt -no OPTIONS /mnt/btrfs | tr ',' '\\n' | grep -Eq '^compress(=zstd(:[0-9]+)?)?$|^compress-force(=zstd(:[0-9]+)?)?$'"
      ],
      "expected_exit": 0,
      "concept_ids": [
        "lpic1.104.1.principes-btrfs-multi-device-compression-subvolumes"
      ]
    }
  ],
  "hint_ids": [
    "lpic1.104.1.filesystem-families.hint-1",
    "lpic1.104.1.filesystem-families.hint-2",
    "lpic1.104.1.filesystem-families.hint-3",
    "lpic1.104.1.filesystem-families.hint-4"
  ],
  "reference_solution_ref": "reference-solution.sh",
  "reset_policy": "disposable"
}
