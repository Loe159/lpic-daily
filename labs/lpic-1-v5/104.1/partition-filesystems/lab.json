{
  "schema_version": "1.0.0",
  "id": "lpic1.104.1.partition-filesystems",
  "title_fr": "Partitionner un disque et créer ses filesystems",
  "brief_fr": "Un nouveau disque /dev/vdb de 512 MiB est attaché à la VM. Initialise-le en GPT, crée une partition ext4 pour les données et une seconde partition destinée au swap. Ne touche pas au disque système /dev/vda.",
  "success_criteria_fr": [
    "/dev/vdb utilise une table de partitions GPT.",
    "/dev/vdb1 est une partition formatée en ext4.",
    "/dev/vdb2 est une partition initialisée comme swap."
  ],
  "debrief_fr": "Le résultat démontre trois compétences distinctes de 104.1 : choisir et créer une table GPT, créer des partitions puis initialiser leurs filesystems. Le montage persistant sera traité séparément dans 104.3.",
  "objective_ids": [
    "104.1"
  ],
  "concept_ids": [
    "lpic1.104.1.mbr-versus-gpt",
    "lpic1.104.1.creation-modification-de-partitions",
    "lpic1.104.1.ext2-ext3-ext4",
    "lpic1.104.1.swap",
    "lpic1.104.1.creation-de-filesystem"
  ],
  "labels": [
    "lpic-required",
    "modern-practice"
  ],
  "estimated_minutes": 20,
  "environment": {
    "backend": "libvirt",
    "image_ref": "fedora-44-x86_64-v1",
    "distribution": "fedora",
    "network": "none",
    "capability_profile": "full-machine",
    "writable_guest_paths": [],
    "machine": {
      "firmware": "uefi",
      "extra_disks": [
        {
          "id": "data",
          "size_mb": 512
        }
      ]
    }
  },
  "resources": {
    "memory_mb": 1024,
    "cpu_percent": 100,
    "pids": 128,
    "timeout_seconds": 1800
  },
  "setup": {
    "execution_scope": "none"
  },
  "checks": [
    {
      "type": "block-device-state",
      "path": "/dev/vdb",
      "device_type": "disk",
      "partition_table": "gpt"
    },
    {
      "type": "block-device-state",
      "path": "/dev/vdb1",
      "device_type": "part",
      "filesystem": "ext4"
    },
    {
      "type": "block-device-state",
      "path": "/dev/vdb2",
      "device_type": "part",
      "filesystem": "swap"
    }
  ],
  "hint_ids": [
    "lpic1.104.1.partition-filesystems.hint-1",
    "lpic1.104.1.partition-filesystems.hint-2",
    "lpic1.104.1.partition-filesystems.hint-3",
    "lpic1.104.1.partition-filesystems.hint-4"
  ],
  "reference_solution_ref": "reference-solution.sh",
  "reset_policy": "disposable"
}
