{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lpic-daily.dev/schemas/achievement.schema.json",
  "title": "LPIC Daily achievement definition",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "title_fr", "description_fr", "xp_reward", "affects_mastery", "trigger"],
  "properties": {
    "schema_version": { "$ref": "common.schema.json#/$defs/schemaVersion" },
    "id": { "$ref": "common.schema.json#/$defs/contentId" },
    "title_fr": { "type": "string", "minLength": 2 },
    "description_fr": { "type": "string", "minLength": 5 },
    "xp_reward": { "type": "integer", "minimum": 0 },
    "affects_mastery": { "const": false },
    "trigger": {
      "type": "object",
      "additionalProperties": false,
      "required": ["metric", "threshold"],
      "properties": {
        "metric": {
          "enum": ["streak-days", "total-xp", "labs-passed", "objectives-demonstrated", "transfer-events", "topic-demonstrated"]
        },
        "threshold": { "type": "integer", "minimum": 1 },
        "objective_id": { "$ref": "common.schema.json#/$defs/objectiveId" },
        "topic": { "type": "string", "pattern": "^[0-9]{3}$" }
      }
    }
  }
}
