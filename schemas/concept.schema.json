{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lpic-daily.dev/schemas/concept.schema.json",
  "title": "LPIC Daily concept",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "objective_id",
    "title_fr",
    "pedagogy_order",
    "anchor_terms",
    "classification",
    "active"
  ],
  "properties": {
    "id": {
      "$ref": "common.schema.json#/$defs/conceptId"
    },
    "objective_id": {
      "$ref": "common.schema.json#/$defs/objectiveId"
    },
    "title_fr": {
      "type": "string",
      "minLength": 1
    },
    "pedagogy_order": {
      "type": "integer",
      "minimum": 1
    },
    "classification": {
      "$ref": "common.schema.json#/$defs/labels"
    },
    "active": {
      "type": "boolean"
    },
    "inherited_hard_objective_prerequisites": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/objectiveId"
      },
      "uniqueItems": true
    },
    "prerequisite_concept_ids": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/conceptId"
      },
      "uniqueItems": true,
      "default": []
    },
    "anchor_terms": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    }
  }
}
