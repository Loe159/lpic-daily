{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lpic-daily.dev/schemas/lab.schema.json",
  "title": "LPIC Daily lab",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "title_fr",
    "brief_fr",
    "success_criteria_fr",
    "debrief_fr",
    "objective_ids",
    "concept_ids",
    "labels",
    "estimated_minutes",
    "practice_context",
    "environment",
    "resources",
    "setup",
    "checks",
    "hint_ids",
    "reset_policy"
  ],
  "properties": {
    "schema_version": {
      "$ref": "common.schema.json#/$defs/schemaVersion"
    },
    "id": {
      "$ref": "common.schema.json#/$defs/contentId"
    },
    "title_fr": {
      "type": "string",
      "minLength": 3
    },
    "brief_fr": {
      "type": "string",
      "minLength": 20
    },
    "success_criteria_fr": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "type": "string",
        "minLength": 5
      },
      "uniqueItems": true
    },
    "debrief_fr": {
      "type": "string",
      "minLength": 20
    },
    "objective_ids": {
      "$ref": "common.schema.json#/$defs/objectiveIds"
    },
    "concept_ids": {
      "$ref": "common.schema.json#/$defs/conceptIds"
    },
    "labels": {
      "$ref": "common.schema.json#/$defs/labels"
    },
    "estimated_minutes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 120
    },
    "practice_context": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9.-]{2,63}$"
    },
    "requires_persistent_shell": {
      "type": "boolean"
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "backend",
        "image_ref",
        "distribution",
        "network",
        "capability_profile"
      ],
      "properties": {
        "backend": {
          "enum": [
            "podman",
            "libvirt"
          ]
        },
        "image_ref": {
          "type": "string",
          "minLength": 8
        },
        "distribution": {
          "$ref": "common.schema.json#/$defs/distribution"
        },
        "network": {
          "enum": [
            "none",
            "isolated"
          ]
        },
        "capability_profile": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]*$"
        },
        "writable_guest_paths": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^/"
          },
          "uniqueItems": true
        },
        "machine": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "firmware"
          ],
          "properties": {
            "firmware": {
              "enum": [
                "bios",
                "uefi"
              ]
            },
            "extra_disks": {
              "type": "array",
              "maxItems": 4,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "size_mb"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^[a-z0-9][a-z0-9-]{0,31}$"
                  },
                  "size_mb": {
                    "type": "integer",
                    "minimum": 64,
                    "maximum": 8192
                  }
                }
              }
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "backend": {
                "const": "libvirt"
              }
            },
            "required": [
              "backend"
            ]
          },
          "then": {
            "required": [
              "machine"
            ],
            "properties": {
              "capability_profile": {
                "const": "full-machine"
              },
              "writable_guest_paths": {
                "maxItems": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "backend": {
                "const": "podman"
              }
            },
            "required": [
              "backend"
            ]
          },
          "then": {
            "not": {
              "required": [
                "machine"
              ]
            },
            "properties": {
              "capability_profile": {
                "enum": [
                  "baseline",
                  "identity-files",
                  "metadata-db",
                  "package-root",
                  "process-lab"
                ]
              },
              "network": {
                "const": "none"
              }
            }
          }
        }
      ]
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "memory_mb",
        "cpu_percent",
        "pids",
        "timeout_seconds"
      ],
      "properties": {
        "memory_mb": {
          "type": "integer",
          "minimum": 64,
          "maximum": 16384
        },
        "pids": {
          "type": "integer",
          "minimum": 16,
          "maximum": 4096
        },
        "timeout_seconds": {
          "type": "integer",
          "minimum": 30,
          "maximum": 7200
        },
        "cpu_percent": {
          "type": "integer",
          "minimum": 10,
          "maximum": 400
        }
      }
    },
    "setup": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "execution_scope"
      ],
      "properties": {
        "execution_scope": {
          "enum": [
            "sandbox",
            "none"
          ]
        },
        "script_ref": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9._/-]+$"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "execution_scope": {
                "const": "sandbox"
              }
            },
            "required": [
              "execution_scope"
            ]
          },
          "then": {
            "required": [
              "script_ref"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "execution_scope": {
                "const": "none"
              }
            },
            "required": [
              "execution_scope"
            ]
          },
          "then": {
            "not": {
              "required": [
                "script_ref"
              ]
            }
          }
        }
      ]
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "path",
              "concept_ids"
            ],
            "properties": {
              "type": {
                "const": "file-exists"
              },
              "path": {
                "type": "string",
                "pattern": "^/"
              },
              "concept_ids": {
                "$ref": "common.schema.json#/$defs/conceptIds"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "path",
              "mode",
              "concept_ids"
            ],
            "properties": {
              "type": {
                "const": "file-mode"
              },
              "path": {
                "type": "string",
                "pattern": "^/"
              },
              "mode": {
                "type": "string",
                "pattern": "^[0-7]{3,4}$"
              },
              "concept_ids": {
                "$ref": "common.schema.json#/$defs/conceptIds"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "path",
              "user",
              "group",
              "concept_ids"
            ],
            "properties": {
              "type": {
                "const": "file-owner"
              },
              "path": {
                "type": "string",
                "pattern": "^/"
              },
              "user": {
                "type": "string",
                "minLength": 1
              },
              "group": {
                "type": "string",
                "minLength": 1
              },
              "concept_ids": {
                "$ref": "common.schema.json#/$defs/conceptIds"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "path",
              "pattern",
              "concept_ids"
            ],
            "properties": {
              "type": {
                "const": "file-content-regex"
              },
              "path": {
                "type": "string",
                "pattern": "^/"
              },
              "pattern": {
                "type": "string",
                "minLength": 1
              },
              "concept_ids": {
                "$ref": "common.schema.json#/$defs/conceptIds"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "match",
              "concept_ids"
            ],
            "properties": {
              "type": {
                "enum": [
                  "process-running",
                  "process-absent"
                ]
              },
              "match": {
                "type": "string",
                "minLength": 1
              },
              "concept_ids": {
                "$ref": "common.schema.json#/$defs/conceptIds"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "argv",
              "expected_exit",
              "concept_ids"
            ],
            "properties": {
              "type": {
                "const": "command-exit"
              },
              "argv": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "minItems": 1
              },
              "expected_exit": {
                "type": "integer",
                "minimum": 0,
                "maximum": 255
              },
              "concept_ids": {
                "$ref": "common.schema.json#/$defs/conceptIds"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "path",
              "concept_ids"
            ],
            "properties": {
              "type": {
                "const": "block-device-state"
              },
              "path": {
                "type": "string",
                "pattern": "^/dev/"
              },
              "device_type": {
                "type": "string",
                "minLength": 1
              },
              "filesystem": {
                "type": "string",
                "minLength": 1
              },
              "partition_table": {
                "type": "string",
                "minLength": 1
              },
              "mountpoint": {
                "type": "string",
                "pattern": "^/"
              },
              "swap_active": {
                "type": "boolean"
              },
              "concept_ids": {
                "$ref": "common.schema.json#/$defs/conceptIds"
              }
            }
          }
        ]
      }
    },
    "hint_ids": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/contentId"
      },
      "uniqueItems": true,
      "minItems": 4,
      "maxItems": 4
    },
    "reference_solution_ref": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9._/-]+$"
    },
    "reset_policy": {
      "const": "disposable"
    },
    "requires_vm_console": {
      "type": "boolean"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "environment": {
            "properties": {
              "backend": {
                "const": "libvirt"
              }
            },
            "required": [
              "backend"
            ]
          }
        },
        "required": [
          "environment"
        ]
      },
      "then": {
        "properties": {
          "resources": {
            "properties": {
              "memory_mb": {
                "minimum": 256
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "requires_vm_console": {
            "const": true
          }
        },
        "required": [
          "requires_vm_console"
        ]
      },
      "then": {
        "properties": {
          "environment": {
            "properties": {
              "backend": {
                "const": "libvirt"
              }
            },
            "required": [
              "backend"
            ]
          }
        }
      }
    }
  ]
}
