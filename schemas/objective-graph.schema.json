{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lpic-daily.dev/schemas/objective-graph.schema.json",
  "title": "LPIC Daily objective prerequisite graph",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "certification", "syllabus_version", "semantics", "recommended_entry_objective", "nodes", "reference_topological_order"],
  "properties": {
    "schema_version": { "$ref": "common.schema.json#/$defs/schemaVersion" },
    "certification": { "const": "LPIC-1" },
    "syllabus_version": { "type": "string", "minLength": 1 },
    "semantics": {
      "type": "object",
      "required": ["hard", "recommended"],
      "additionalProperties": false,
      "properties": {
        "hard": { "type": "string", "minLength": 1 },
        "recommended": { "type": "string", "minLength": 1 }
      }
    },
    "recommended_entry_objective": { "$ref": "common.schema.json#/$defs/objectiveId" },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["objective_id", "hard_prerequisites", "recommended_prerequisites", "rationale_fr"],
        "properties": {
          "objective_id": { "$ref": "common.schema.json#/$defs/objectiveId" },
          "hard_prerequisites": {
            "type": "array",
            "items": { "$ref": "common.schema.json#/$defs/objectiveId" },
            "uniqueItems": true
          },
          "recommended_prerequisites": {
            "type": "array",
            "items": { "$ref": "common.schema.json#/$defs/objectiveId" },
            "uniqueItems": true
          },
          "rationale_fr": { "type": "string", "minLength": 8 }
        }
      }
    },
    "reference_topological_order": {
      "type": "array",
      "items": { "$ref": "common.schema.json#/$defs/objectiveId" },
      "minItems": 1,
      "uniqueItems": true
    }
  }
}
